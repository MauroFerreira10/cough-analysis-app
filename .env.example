# Exemplo de arquivo de configuração de ambiente
# Copie para .env e preencha com seus valores

# Python Environment
PYTHONPATH=.

# TensorFlow Settings
TF_CPP_MIN_LOG_LEVEL=2  # 0=all, 1=info, 2=warning, 3=error
TF_ENABLE_ONEDNN_OPTS=0

# CUDA Settings (se usar GPU)
CUDA_VISIBLE_DEVICES=0

# Paths
DATA_DIR=data
MODEL_DIR=data/models
LOG_DIR=logs

# Training
BATCH_SIZE=32
EPOCHS=100
LEARNING_RATE=0.001

# MLflow (opcional)
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=cough_detection

# WandB (opcional)
# WANDB_API_KEY=your_key_here
# WANDB_PROJECT=cough-detection

